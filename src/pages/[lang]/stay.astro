---
import TopicLayout from '../../layouts/TopicLayout.astro';
import th from '../../i18n/th.json';
import en from '../../i18n/en.json';
import zh from '../../i18n/zh.json';
import { languagesList, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return languagesList.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const m = { th, en, zh }[lang];
const services = m.services;
const guide = m.guide;
const s = m.topics.stay;
const pick = (icons: string[]) => services.items.filter((i: any) => icons.includes(i.icon));
---

<TopicLayout lang={lang} messages={m} topic="stay">
  <section>
    <h2 class="font-display text-2xl text-teak">{services.heading}</h2>
    <p class="mt-2 text-stone-600">{services.lead}</p>
    <div class="mt-4 space-y-4">
      {
        pick(['🏡', '🍜', '🏪', '💊', '🚻']).map((i: any) => (
          <article class="rounded-2xl border border-stone-300 bg-white/50 p-5">
            <h3 class="font-semibold text-stone-800">
              <span class="mr-2">{i.icon}</span>
              {i.name}
              <span class="ml-2 text-xs font-normal text-stone-500">{i.type}</span>
            </h3>
            <p class="mt-1 text-stone-600">{i.desc}</p>
            {i.tip && <p class="mt-2 text-sm text-amber-800">{i.tip}</p>}
          </article>
        ))
      }
    </div>
  </section>

  <section>
    <h2 class="font-display text-2xl text-teak">{guide.fees.title}</h2>
    <div class="mt-4 grid sm:grid-cols-2 gap-4">
      {
        guide.fees.items.map((i: any) => (
          <article class="rounded-2xl border border-stone-300 bg-white/50 p-5">
            <h3 class="font-semibold text-stone-800">{i.title}</h3>
            <p class="mt-1 text-stone-600">{i.desc}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section>
    <h2 class="font-display text-2xl text-teak">{s.roomTypesTitle}</h2>
    <div class="mt-4 grid sm:grid-cols-2 gap-4">
      {
        s.roomTypes.map((i: any) => (
          <article class="rounded-2xl border border-stone-300 bg-white/50 p-5">
            <h3 class="font-semibold text-stone-800">{i.name}</h3>
            <p class="mt-1 text-stone-600">{i.desc}</p>
          </article>
        ))
      }
    </div>
    <p class="mt-3 text-sm text-amber-800">{s.roomNote}</p>
  </section>

  <section>
    <h2 class="font-display text-2xl text-teak">{s.bookingTitle}</h2>
    <ul class="mt-4 space-y-2 text-stone-600 list-disc pl-5">
      {s.booking.map((item: string) => <li>{item}</li>)}
    </ul>
  </section>

  <section>
    <h2 class="font-display text-2xl text-teak">{s.priceTitle}</h2>
    <ul class="mt-4 space-y-2 text-stone-600 list-disc pl-5">
      {s.priceFactors.map((item: string) => <li>{item}</li>)}
    </ul>
    <p class="mt-3 text-sm text-amber-800">{s.priceNote}</p>
  </section>

  <section>
    <h2 class="font-display text-2xl text-teak">{s.suitsTitle}</h2>
    <div class="mt-4 grid sm:grid-cols-2 gap-4">
      {
        s.suits.map((i: any) => (
          <article class="rounded-2xl border border-stone-300 bg-white/50 p-5">
            <h3 class="font-semibold text-stone-800">{i.name}</h3>
            <p class="mt-1 text-stone-600">{i.desc}</p>
          </article>
        ))
      }
    </div>
  </section>

  {
    m.plan.audiences && (
      <section>
        <h2 class="font-display text-2xl text-teak">{m.plan.audienceTitle}</h2>
        <div class="mt-4 space-y-4">
          {m.plan.audiences
            .filter((a: any) => a.tag === '👨‍👩‍👧' || a.tag === '♿')
            .map((a: any) => (
              <article class="rounded-2xl border border-stone-300 bg-white/50 p-5">
                <h3 class="font-semibold text-stone-800">
                  <span class="mr-2">{a.tag}</span>
                  {a.name}
                </h3>
                <p class="mt-1 text-stone-600">{a.desc}</p>
                <ol class="mt-3 list-decimal pl-5 text-sm text-stone-700 space-y-1">
                  {a.steps.map((s: string) => (
                    <li>{s}</li>
                  ))}
                </ol>
              </article>
            ))}
        </div>
      </section>
    )
  }
</TopicLayout>
