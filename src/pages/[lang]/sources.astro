---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sources from '../../components/Sources.astro';
import Footer from '../../components/Footer.astro';
import { getI18n, languagesList } from '../../i18n/ui';

export function getStaticPaths() {
  return languagesList.map((lang) => ({ params: { lang } }));
}
const { lang, messages } = await getI18n(Astro.url);
---
<BaseLayout lang={lang} title={`${messages.sources.heading} — ${messages.footer.brand.name}`} description={messages.sources.intro} messages={messages} path="sources">
  <main class="pt-16">
    <div class="bg-teakDeep px-5 pt-8"><a href={`/${lang}/`} class="text-goldBright hover:underline">← {messages.header.home}</a></div>
    <Sources messages={messages} />
  </main>
  <Footer lang={lang} messages={messages} />
</BaseLayout>
