---
import TopicLayout from '../../layouts/TopicLayout.astro';
import th from '../../i18n/th.json';
import en from '../../i18n/en.json';
import zh from '../../i18n/zh.json';
import { languagesList, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return languagesList.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const m = { th, en, zh }[lang];
const guide = m.guide;
const plan = m.plan;
---

<TopicLayout lang={lang} messages={m} topic="plan">
  <section class="rounded-2xl border border-gold/40 bg-white/50 p-6">
    <p class="font-hand text-xl text-amber-700">{guide.hours.tag}</p>
    <p class="mt-1 font-display text-2xl text-teak">{guide.hours.time}</p>
    <dl class="mt-4 flex flex-wrap gap-x-8 gap-y-2 text-sm">
      {
        guide.hours.items.map((i: any) => (
          <div>
            <dt class="text-stone-500">{i.label}</dt>
            <dd class="font-semibold text-stone-800">{i.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section>
    <h2 class="font-display text-2xl text-teak">{guide.fees.title}</h2>
    <div class="mt-4 grid sm:grid-cols-2 gap-4">
      {
        guide.fees.items.map((i: any) => (
          <article class="rounded-2xl border border-stone-300 bg-white/50 p-5">
            <h3 class="font-semibold text-stone-800">{i.title}</h3>
            <p class="mt-1 text-stone-600">{i.desc}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section>
    <h2 class="font-display text-2xl text-teak">{plan.seasonsTitle}</h2>
    <p class="mt-2 text-stone-600">{plan.seasonsNote}</p>
    <div class="mt-4 space-y-4">
      {
        plan.seasons.map((s: any) => (
          <article class="rounded-2xl border border-stone-300 bg-white/50 p-5">
            <h3 class="font-semibold text-stone-800">{s.q}</h3>
            <dl class="mt-2 grid sm:grid-cols-2 gap-x-6 gap-y-1 text-sm">
              <div>
                <dt class="text-stone-500">{plan.seasonsCols[1]}</dt>
                <dd class="text-stone-700">{s.weather}</dd>
              </div>
              <div>
                <dt class="text-stone-500">{plan.seasonsCols[2]}</dt>
                <dd class="text-stone-700">{s.water}</dd>
              </div>
              <div>
                <dt class="text-stone-500">{plan.seasonsCols[3]}</dt>
                <dd class="text-stone-700">{s.wildlife}</dd>
              </div>
              <div>
                <dt class="text-stone-500">{plan.seasonsCols[4]}</dt>
                <dd class="text-stone-700">{s.good}</dd>
              </div>
            </dl>
            <p class="mt-3 text-sm text-amber-800">{s.tip}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section>
    <h2 class="font-display text-2xl text-teak">{plan.audienceTitle}</h2>
    <div class="mt-4 space-y-4">
      {
        plan.audiences.map((a: any) => (
          <article class="rounded-2xl border border-stone-300 bg-white/50 p-5">
            <h3 class="font-semibold text-stone-800">
              <span class="mr-2">{a.tag}</span>
              {a.name}
            </h3>
            <p class="mt-1 text-stone-600">{a.desc}</p>
            <ol class="mt-3 list-decimal pl-5 text-sm text-stone-700 space-y-1">
              {a.steps.map((s: string) => (
                <li>{s}</li>
              ))}
            </ol>
          </article>
        ))
      }
    </div>
  </section>
</TopicLayout>
