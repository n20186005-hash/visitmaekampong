---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Footer from '../../../components/Footer.astro';
import { languagesList, type Lang } from '../../../i18n/ui';
import th from '../../../i18n/th.json';
import en from '../../../i18n/en.json';
import zh from '../../../i18n/zh.json';
export function getStaticPaths() { return languagesList.map(lang => ({params:{lang}})); }
const {lang} = Astro.params as {lang: Lang};
const messages = {th,en,zh}[lang];
const map = 'https://www.google.com/maps/search/?api=1&query=%E0%B8%96%E0%B9%89%E0%B8%B3%E0%B9%80%E0%B8%A1%E0%B8%B7%E0%B8%AD%E0%B8%87%E0%B8%AD%E0%B8%AD%E0%B8%99+%E0%B8%9A%E0%B9%89%E0%B8%B2%E0%B8%99%E0%B8%AA%E0%B8%AB%E0%B8%81%E0%B8%A3%E0%B8%93%E0%B9%8C+%E0%B9%81%E0%B8%A1%E0%B9%88%E0%B8%AD%E0%B8%AD%E0%B8%99+%E0%B9%80%E0%B8%8A%E0%B8%B5%E0%B8%A2%E0%B8%87%E0%B9%83%E0%B8%AB%E0%B8%A1%E0%B9%88';
const c = {
 th:{name:'ถ้ำเมืองออน',sub:'ถ้ำหินปูนและศาสนสถานในอำเภอแม่ออน',home:'หน้าแรก',directory:'สถานที่ใกล้เคียง',about:'เกี่ยวกับถ้ำและการดูแล',management:'ถ้ำเมืองออนตั้งอยู่ตำบลบ้านสหกรณ์ อำเภอแม่ออน เป็นทั้งแหล่งธรรมชาติและสถานที่ศักดิ์สิทธิ์ โปรดตรวจสอบผู้ดูแลพื้นที่ กฎการเข้าชม และกิจกรรมทางศาสนากับเจ้าหน้าที่หรือผู้ดูแลในวันที่ไป',intro:'ฐานข้อมูลกระทรวงการท่องเที่ยวและกีฬาระบุว่าถ้ำเดิมชื่อถ้ำดอยศิลา ภายในมีโถงหินปูน หินงอกหินย้อย พระพุทธรูป และพระธาตุนมผาซึ่งเป็นสิ่งศักดิ์สิทธิ์ประจำถ้ำ',plan:'วางแผนก่อนเดินทาง',facts:'ตำบลบ้านสหกรณ์ อำเภอแม่ออน จังหวัดเชียงใหม่ 50130 เวลาทำการและค่าธรรมเนียมควรสอบถามหน้างาน แยกจากค่าเดินทางและบริการอื่น ๆ',access:'จากแม่กำปองเดินทางโดยรถไปยังถ้ำเมืองออน ตรวจสอบเส้นทาง สภาพถนน และรถขากลับก่อนออกเดินทาง ถ้ำเป็นจุดแวะต่างหากจากน้ำพุร้อนสันกำแพง',route:'เส้นทางแนะนำ',steps:['ตรวจสอบสภาพอากาศและเวลาเข้าชมก่อนออกจากแม่กำปอง','เดินทางไปยังทางเข้าถ้ำเมืองออนในบ้านสหกรณ์','เดินตามบันไดและทางที่ผู้ดูแลเปิดให้เข้าชม','ชมพระธาตุนมผาและหินงอกหินย้อยโดยไม่สัมผัส แล้วกลับทางเดิม'],safety:'ทางเข้ามีบันไดลงสู่โถงถ้ำ พื้นอาจลื่น สวมรองเท้ายึดเกาะดีและตรวจสอบความเหมาะสมหากมีข้อจำกัดด้านการเดิน เคารพเขตศาสนสถานและคำแนะนำของผู้ดูแล',photo:'ถ่ายภาพจากทางเดินที่เปิดใช้ โดยไม่จับหินงอกหินย้อยหรือรบกวนผู้ประกอบพิธี',stay:'สามารถพักในแม่กำปองหรือบริเวณแม่ออน แล้ววางแผนรถกลับล่วงหน้า',faq:'คำถามที่พบบ่อย',qs:[['ถ้ำมีอะไรให้ชม?','มีโถงถ้ำ หินงอกหินย้อย พระพุทธรูป และพระธาตุนมผา'],['เข้าถึงโดยไม่มีบันไดได้ไหม?','ทางเข้ามีบันไดลงถ้ำ สอบถามผู้ดูแลเกี่ยวกับการเข้าถึงก่อนเดินทาง'],['ถ้ำอยู่ในหมู่บ้านแม่กำปองหรือไม่?','ไม่ใช่ อยู่ตำบลบ้านสหกรณ์ในอำเภอแม่ออน ต้องเดินทางแยกไป'],['ถ่ายภาพภายในได้ไหม?','ตรวจสอบกฎหน้างานและเคารพผู้มาไหว้พระ']],source:'ข้อมูลอ้างอิง: กระทรวงการท่องเที่ยวและกีฬา',map:'แผนที่และรีวิว',more:'สำรวจสถานที่ใกล้เคียง'},
 en:{name:'Muang On Cave',sub:'A limestone cave and sacred site in Mae On',home:'Home',directory:'Nearby places',about:'About and management',management:'Muang On Cave is in Ban Sahakon, Mae On. It is both a natural site and a place of worship. Confirm the responsible on-site caretaker, access rules and religious activities locally before visiting.',intro:'Thailand’s Ministry of Tourism and Sports records the former name Doi Sila Cave and describes a limestone chamber with stalactites, stalagmites, Buddha images and the sacred Phra That Nom Pha formation.',plan:'Plan your visit',facts:'Ban Sahakon Subdistrict, Mae On District, Chiang Mai 50130. Confirm current opening hours and admission locally; transport and any other services are separate.',access:'Travel by road from Mae Kampong to Muang On Cave. Check the route, road conditions and return transport before leaving. The cave is a separate stop from San Kamphaeng Hot Springs.',route:'Suggested visit',steps:['Check weather and visitor access before leaving Mae Kampong.','Travel to the cave entrance in Ban Sahakon.','Follow the stairs and routes open to visitors.','See Phra That Nom Pha and the formations without touching them, then return along the permitted route.'],safety:'Stairs descend into the cave and surfaces can be slippery. Wear footwear with good grip and check accessibility in advance if stairs are difficult. Respect worship and on-site instructions.',photo:'Photograph from permitted paths without touching formations or disturbing worshippers.',stay:'Stay in Mae Kampong or the Mae On area and arrange return transport in advance.',faq:'Frequently asked questions',qs:[['What is inside?','The cave has a chamber, limestone formations, Buddha images and the sacred Phra That Nom Pha.'],['Is it step-free?','The entrance involves stairs down into the cave. Ask the caretaker about access before travelling.'],['Is the cave in Mae Kampong Village?','No. It is in Ban Sahakon, Mae On, and requires a separate journey.'],['Can I photograph inside?','Check the current rules on site and respect people worshipping.']],source:'Reference: Ministry of Tourism and Sports',map:'Map and reviews',more:'Explore nearby'},
 zh:{name:'湄安洞（Muang On Cave）',sub:'湄安縣的石灰岩洞與宗教場所',home:'首頁',directory:'周邊景點',about:'關於洞穴與管理',management:'湄安洞位於湄安縣 Ban Sahakon，兼具自然景觀與宗教場所性質。出發前或抵達時請向現場人員確認實際管理者、開放規則及宗教活動安排。',intro:'泰國觀光與體育部資料記載洞穴舊稱 Doi Sila Cave，洞內有石灰岩洞廳、鐘乳石、石筍、佛像與被視為聖物的 Phra That Nom Pha。',plan:'遊覽準備',facts:'清邁府湄安縣 Ban Sahakon 分區 50130。開放時間及門票請向現場核實；交通及其他服務費用另計。',access:'從湄甘蓬村乘車前往湄安洞，出發前確認路線、路況及回程交通。洞穴與山甘烹溫泉是兩個獨立停留點。',route:'建議路線',steps:['離開湄甘蓬前確認天氣及洞穴開放情況。','乘車到 Ban Sahakon 的湄安洞入口。','沿開放的樓梯及路線進入洞內。','欣賞 Phra That Nom Pha 和洞穴石景，不觸摸鐘乳石，再沿許可路線返回。'],safety:'入口有樓梯通往洞廳，地面可能濕滑；穿防滑鞋，行動不便者先向管理人員確認通行條件。尊重宗教活動及現場指示。',photo:'在允許的步道拍攝，不觸摸洞穴石景，也不打擾禮佛者。',stay:'可選擇住在湄甘蓬或湄安一帶，並預先安排回程交通。',faq:'常見問題',qs:[['洞內有什麼？','有洞廳、鐘乳石與石筍、佛像及聖物 Phra That Nom Pha。'],['可以無障礙進入嗎？','入口須下樓梯；如有通行需求，請先向現場管理者查詢。'],['洞穴在湄甘蓬村裡嗎？','不在；它位於湄安縣 Ban Sahakon，須另行乘車前往。'],['洞內可以拍照嗎？','請確認現場規定，並尊重正在禮佛的人。']],source:'參考資料：泰國觀光與體育部',map:'地圖與評論',more:'探索周邊'}
}[lang];
---
<BaseLayout lang={lang} title={`${c.name} | Mae Kampong`} description={c.sub} messages={messages} path="nearby/muang-on-cave" crumb={c.name}>
 <main class="mx-auto max-w-3xl px-5 py-16 md:py-24 text-stone-700">
  <nav class="text-sm text-amber-800"><a href={`/${lang}/`}>{c.home}</a> / <a href={`/${lang}/attractions/`}>{c.directory}</a> / {c.name}</nav>
  <nav class="mt-5 flex gap-4 text-sm text-amber-800" aria-label="Language">{languagesList.map(l=><a href={`/${l}/nearby/muang-on-cave/`} aria-current={l === lang ? 'page' : undefined}>{{th:'ไทย',en:'English',zh:'中文'}[l]}</a>)}</nav>
  <h1 class="mt-8 font-display text-3xl md:text-5xl font-semibold text-teak">{c.name}</h1><p class="mt-4 text-xl">{c.sub}</p>
  <a class="mt-5 inline-block rounded-full bg-amber-800 text-white px-4 py-2" href={map} target="_blank" rel="noopener noreferrer">{c.map} ↗</a>
  <div class="mt-10 space-y-10 leading-7">
   <section class="rounded-2xl border border-gold/40 bg-white/60 p-6"><h2 class="font-display text-2xl text-teak">{c.about}</h2><p class="mt-3">{c.management}</p></section>
   <section><p>{c.intro}</p></section><section><h2 class="font-display text-2xl text-teak">{c.plan}</h2><p class="mt-2">{c.facts}</p><p class="mt-3">{c.access}</p></section>
   <section><h2 class="font-display text-2xl text-teak">{c.route}</h2><ol class="mt-3 list-decimal pl-5 space-y-2">{c.steps.map(step=><li>{step}</li>)}</ol><p class="mt-3">{c.safety}</p><p class="mt-3">{c.photo}</p><p class="mt-3">{c.stay} <a class="text-amber-800 underline" href={`/${lang}/stay/`}>{messages.topics.stay.navLabel}</a></p></section>
   <section><h2 class="font-display text-2xl text-teak">{c.faq}</h2><dl class="mt-3 space-y-3">{c.qs.map(([q,a])=><div class="rounded-xl border border-stone-300 bg-white/50 p-4"><dt class="font-semibold">{q}</dt><dd class="mt-1">{a}</dd></div>)}</dl></section>
   <p><a class="text-amber-800 underline" href="https://www.thailandtourismdirectory.go.th/attraction/2095">{c.source} ↗</a></p>
   <section><h2 class="font-display text-2xl text-teak">{c.more}</h2><a class="text-amber-800 underline" href={`/${lang}/attractions/`}>{c.directory} →</a></section>
  </div>
 </main><Footer lang={lang} messages={messages}/>
</BaseLayout>
