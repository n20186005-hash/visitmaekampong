---
import BaseLayout from './BaseLayout.astro';
import Footer from '../components/Footer.astro';
import type { Lang } from '../i18n/ui';

/**
 * Shared shell for the topic landing pages (/transport, /stay, /attractions, /plan).
 * Each page keeps its own canonical + hreflang cluster, ships FAQPage JSON-LD and
 * links back to the hub so the cluster is crawlable in both directions.
 */
interface Props {
  lang: Lang;
  messages: Record<string, any>;
  topic: 'transport' | 'stay' | 'attractions' | 'plan';
}

const { lang, messages, topic } = Astro.props;
const t = messages.topics;
const page = t[topic];
const home = `/${lang}/`;

const order = ['transport', 'stay', 'attractions', 'plan'] as const;
const links = [
  { href: home, label: t.homeLabel },
  ...order.filter((k) => k !== topic).map((k) => ({ href: `/${lang}/${k}/`, label: t[k].navLabel })),
];
---

<BaseLayout
  lang={lang}
  title={page.meta.title}
  description={page.meta.description}
  messages={messages}
  path={topic}
  crumb={page.heading}
  faqs={page.faqs}
>
  <main class="mx-auto max-w-3xl px-5 py-16 md:py-24">
    <nav aria-label="breadcrumb" class="text-sm text-stone-500">
      <a href={home} class="text-amber-700 hover:underline">{t.homeLabel}</a>
      <span class="px-2 text-stone-400">/</span>
      <span class="text-stone-700">{page.heading}</span>
    </nav>

    <p class="mt-8 font-hand text-2xl text-amber-700">{t.label}</p>
    <h1 class="mt-1 font-display text-3xl md:text-5xl font-semibold text-teak">{page.heading}</h1>
    <p class="mt-4 text-lg text-stone-600">{page.lead}</p>

    <div class="mt-10 space-y-10">
      <slot />
    </div>

    <section class="mt-14 rounded-2xl border border-gold/40 bg-white/50 p-6">
      <h2 class="font-display text-2xl text-teak">{t.faqTitle}</h2>
      <dl class="mt-4 space-y-5">
        {
          page.faqs.map((f: { q: string; a: string }) => (
            <div>
              <dt class="font-semibold text-stone-800">{f.q}</dt>
              <dd class="mt-1 text-stone-600">{f.a}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="mt-10">
      <h2 class="font-display text-2xl text-teak">{t.moreTitle}</h2>
      <ul class="mt-4 grid sm:grid-cols-2 gap-3">
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                class="block rounded-xl border border-stone-300 bg-white/40 px-4 py-3 text-stone-700 hover:border-amber-600 hover:text-amber-800 transition-colors"
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>

  <Footer lang={lang} messages={messages} />
</BaseLayout>
