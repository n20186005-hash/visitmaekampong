---
import { siteConfig } from '../config';
import { nearby } from '../data/nearby';
import { experiences } from '../data/experiences';

interface Props {
  lang: any;
  messages: Record<string, any>;
}
const { lang, messages } = Astro.props;
const footer = messages.footer;
const mapsUrl = siteConfig.mapsUrl;
// Topic landing pages — the crawlable entry points into the guide cluster.
const topicKeys = ['transport', 'stay', 'mae-kampong-waterfall', 'attractions', 'plan'];
const topics = messages.topics;
---

<footer class="bg-teakDeep text-ivory pt-16 pb-8">
  <div class="max-w-7xl mx-auto px-5">
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-10">
      <div>
        <div class="font-display text-2xl text-goldBright">{footer.brand.name}</div>
        <p class="font-hand text-gold text-lg mt-1">{footer.brand.tagline}</p>
        <p class="mt-4 text-sm text-ivory/70 max-w-sm">{footer.about}</p>
      </div>

      <div>
        <div class="text-xs uppercase tracking-wider text-gold mb-3">{footer.navTitle}</div>
        <ul class="grid grid-cols-2 gap-2 text-sm">
          {footer.navItems.map((n: any) => (
            <li><a href={n.href === '#reviews' ? `/${lang}/reviews/` : n.href === '#sources' ? `/${lang}/sources/` : n.href.startsWith('#') ? `/${lang}/${n.href}` : n.href} class="text-ivory/80 hover:text-goldBright transition-colors">{n.label}</a></li>
          ))}
        </ul>
      </div>

      {
        topics && (
          <div>
            <div class="text-xs uppercase tracking-wider text-gold mb-3">{topics.label}</div>
            <ul class="grid grid-cols-2 gap-2 text-sm">
              {topicKeys.map((k) => (
                <li>
                  <a href={`/${lang}/${k}/`} class="text-ivory/80 hover:text-goldBright transition-colors">
                    {(k === 'mae-kampong-waterfall' ? topics.waterfall : topics[k]).navLabel}
                  </a>
                </li>
              ))}
              {(Object.keys(nearby) as (keyof typeof nearby)[]).map(slug => (
                <li><a href={`/${lang}/nearby/${slug}/`} class="text-ivory/80 hover:text-goldBright transition-colors">{nearby[slug][lang as 'th'|'en'|'zh'].name}</a></li>
              ))}
              {(Object.keys(experiences) as (keyof typeof experiences)[]).map(slug => (
                <li><a href={`/${lang}/guides/${slug}/`} class="text-ivory/80 hover:text-goldBright transition-colors">{experiences[slug][lang as 'th'|'en'|'zh'].title}</a></li>
              ))}
            </ul>
          </div>
        )
      }

      <div>
        <div class="text-xs uppercase tracking-wider text-gold mb-3">{footer.noteTitle}</div>
        <p class="text-sm text-ivory/70">{footer.note}</p>
        <a
          href={mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-5 inline-flex items-center gap-2 bg-gold text-teak font-semibold px-5 py-2.5 rounded-full hover:bg-goldBright transition-colors"
        >
          {footer.mapsLabel}
        </a>
      </div>
    </div>

    <div class="mt-12 border-t border-ivory/10 pt-8 flex flex-wrap gap-x-5 gap-y-2 text-xs">
      <a href={`/${lang}/reviews/`} class="text-ivory/60 hover:text-goldBright underline-offset-2 hover:underline">{messages.reviews.label}</a>
      <a href={`/${lang}/sources/`} class="text-ivory/60 hover:text-goldBright underline-offset-2 hover:underline">{messages.sources.label}</a>
      <a href={`/${lang}/privacy-policy`} class="text-ivory/60 hover:text-goldBright underline-offset-2 hover:underline">{footer.privacy}</a>
      <a href={`/${lang}/terms-of-service`} class="text-ivory/60 hover:text-goldBright underline-offset-2 hover:underline">{footer.terms}</a>
      <a href={`/${lang}/cookie-settings`} class="text-ivory/60 hover:text-goldBright underline-offset-2 hover:underline">{footer.cookies}</a>
    </div>

    <div class="ornament my-10 opacity-60"></div>

    <div class="text-xs text-ivory/60 leading-relaxed space-y-2">
      <p>{footer.copyright}</p>
      <p>{footer.unofficial}</p>
    </div>
  </div>
</footer>
