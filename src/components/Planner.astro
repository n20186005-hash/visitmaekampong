---
interface Props {
  messages: Record<string, any>;
}
const { messages } = Astro.props;
const pl = messages.plan;
const cols: string[] = pl?.seasonsCols ?? [];
---

{
  pl && (
    <section id="plan" class="py-20 bg-teakDeep text-ivory">
      <div class="max-w-7xl mx-auto px-5">
        <p class="font-hand text-gold text-xl md:text-2xl">{pl.label}</p>
        <h2 class="font-display font-semibold text-3xl md:text-5xl text-ivory mt-2">{pl.heading}</h2>
        <p class="mt-4 max-w-3xl text-ivory/80">{pl.lead}</p>

        <!-- 季度游览策略表：气象 / 水质 / 野生动物综合分析 -->
        <h3 class="mt-12 font-display text-2xl text-goldBright">{pl.seasonsTitle}</h3>
        <p class="mt-2 text-sm text-ivory/65 max-w-3xl">{pl.seasonsNote}</p>
        <div class="mt-4 overflow-x-auto rounded-2xl border border-gold/20">
          <table class="w-full min-w-[900px] text-left text-sm">
            <thead class="bg-gold/10 text-goldBright">
              <tr>
                {cols.map((c) => (
                  <th scope="col" class="px-4 py-3 font-semibold whitespace-nowrap">{c}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {pl.seasons.map((s: any, i: number) => (
                <tr class={i % 2 ? 'bg-white/[0.03]' : ''}>
                  <th scope="row" class="px-4 py-4 align-top font-semibold text-ivory whitespace-nowrap">{s.q}</th>
                  <td class="px-4 py-4 align-top text-ivory/80">{s.weather}</td>
                  <td class="px-4 py-4 align-top text-ivory/80">{s.water}</td>
                  <td class="px-4 py-4 align-top text-ivory/80">{s.wildlife}</td>
                  <td class="px-4 py-4 align-top text-ivory/80">{s.good}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <ul class="mt-4 space-y-2 text-sm text-ivory/75">
          {pl.seasons.map((s: any) => (
            <li class="flex gap-2">
              <span class="text-gold" aria-hidden="true">•</span>
              <span><strong class="text-ivory">{s.q}</strong> — {s.tip}</span>
            </li>
          ))}
        </ul>

        <!-- 按人群定制 -->
        <h3 class="mt-14 font-display text-2xl text-goldBright">{pl.audienceTitle}</h3>
        <div class="mt-4 grid md:grid-cols-3 gap-4">
          {pl.audiences.map((a: any) => (
            <article class="rounded-2xl border border-gold/25 bg-teak/40 p-6">
              <div class="text-3xl" aria-hidden="true">{a.tag}</div>
              <h4 class="mt-2 font-display text-xl text-ivory">{a.name}</h4>
              <p class="mt-2 text-sm text-ivory/75">{a.desc}</p>
              <ol class="mt-4 space-y-2 text-sm text-ivory/80">
                {a.steps.map((st: string, i: number) => (
                  <li class="flex gap-2">
                    <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full border border-gold/50 text-[11px] text-goldBright">
                      {i + 1}
                    </span>
                    <span>{st}</span>
                  </li>
                ))}
              </ol>
            </article>
          ))}
        </div>

        <!-- 半日 / 全日推荐路线 -->
        <h3 class="mt-14 font-display text-2xl text-goldBright">{pl.routesTitle}</h3>
        <div class="mt-4 grid lg:grid-cols-2 gap-4">
          {pl.routes.map((r: any) => (
            <article class="rounded-2xl border border-gold/25 bg-teak/40 p-6">
              <span class="inline-block rounded-full bg-gold/15 px-3 py-1 text-xs text-goldBright">{r.tag}</span>
              <h4 class="mt-3 font-display text-xl text-ivory">{r.name}</h4>
              <ol class="mt-4 space-y-3">
                {r.steps.map((st: any) => (
                  <li class="flex gap-3">
                    <span class="w-14 shrink-0 font-semibold text-goldBright">{st.time}</span>
                    <span class="text-sm text-ivory/85">{st.text}</span>
                  </li>
                ))}
              </ol>
            </article>
          ))}
        </div>
      </div>
    </section>
  )
}
