---
interface Props {
  messages: Record<string, any>;
}
const { messages } = Astro.props;
const eco = messages.eco;
---

<section id="eco" class="py-20 bg-sand text-ink">
  <div class="max-w-7xl mx-auto px-5">
    <p class="font-hand text-gold text-xl md:text-2xl">{eco.label}</p>
    <h2 class="font-display font-semibold text-3xl md:text-5xl text-teak mt-2">{eco.heading}</h2>

    <blockquote class="border-l-4 border-gold pl-5 italic text-teak font-display text-xl my-6 max-w-3xl">
      “{eco.quote}”
    </blockquote>

    <p class="max-w-3xl text-ink/85">{eco.intro}</p>

    <!-- Microclimate -->
    <h3 class="font-display text-2xl text-teak mt-12 mb-4">{eco.microTitle}</h3>
    <div class="grid md:grid-cols-3 gap-4">
      {eco.micro.map((m) => (
        <div class="rounded-xl border border-gold/25 bg-white/50 p-5">
          <div class="font-semibold text-teak mb-1">{m.title}</div>
          <p class="text-sm text-ink/75">{m.desc}</p>
        </div>
      ))}
    </div>

    <!-- Fauna & Flora checklist (Accordion) -->
    <div class="mt-16 grid md:grid-cols-2 gap-10">
      <div>
        <h3 class="font-display text-2xl text-teak mb-4">{eco.plantsTitle}</h3>
        <div class="space-y-3">
          {eco.plants.map((p: any, i: number) => (
            <div class="accordion-item border border-gold/20 rounded-xl overflow-hidden bg-ivory">
              <button class="accordion-btn w-full px-5 py-4 flex items-center justify-between text-left hover:bg-gold/5 transition-colors focus:outline-none">
                <div>
                  <span class="font-semibold text-teak">{p.title}</span>
                  <span class="block text-xs text-ink/60 mt-0.5">{p.desc}</span>
                </div>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gold transform transition-transform duration-300 accordion-icon" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                </svg>
              </button>
              <div class="accordion-content max-h-0 overflow-hidden transition-all duration-300 ease-in-out">
                <ul class="p-5 pt-0 space-y-3 text-sm border-t border-gold/10">
                  {p.items.map((it: any) => (
                    <li class="flex items-start gap-3">
                      <span class="text-gold mt-0.5">🌱</span>
                      <div>
                        <span class="font-medium text-ink/90">{it.name}</span>
                        <span class="block text-ink/60 text-xs mt-0.5">{it.desc}</span>
                      </div>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div>
        <h3 class="font-display text-2xl text-teak mb-4">{eco.wildlifeTitle}</h3>
        <div class="bg-white border border-gold/20 rounded-2xl p-6 shadow-sm">
          <ul class="space-y-4">
            {eco.wildlife.map((w: string) => (
              <li class="flex items-start gap-3 text-sm text-ink/80 pb-4 border-b border-gold/10 last:border-0 last:pb-0">
                <span class="text-goldBright text-lg">🐾</span>
                <span class="leading-relaxed mt-0.5">{w}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <!-- Leave No Trace -->
    <div class="mt-12 rounded-2xl border border-teak/30 bg-teak/5 p-6 relative overflow-hidden" id="lnt-container">
      <h4 class="font-display text-xl text-teak mb-2">{eco.lntTitle}</h4>
      <p class="text-sm text-ink/75 mb-3">{eco.lntIntro}</p>
      <ul class="space-y-2 text-sm text-ink/80 relative z-10">
        {eco.lnt.map((t: string, i: number) => (
          <li>
            <label class="flex items-start gap-3 cursor-pointer group rounded-lg px-2 py-1.5 -mx-2 hover:bg-teak/5 transition-colors">
              <input type="checkbox" id={`lnt-${i}`} class="lnt-checkbox peer mt-0.5 h-5 w-5 shrink-0 accent-teak cursor-pointer" />
              <span class="leading-relaxed peer-checked:line-through peer-checked:text-ink/45 transition-colors">{t}</span>
            </label>
          </li>
        ))}
      </ul>
      {eco.lntCheckHint && (
        <p class="mt-4 text-xs font-medium text-teak/80" id="lnt-hint">{eco.lntCheckHint}</p>
      )}
      
      <!-- Thank you message overlay -->
      <div id="lnt-thankyou" class="absolute inset-0 bg-teakDeep/95 flex items-center justify-center text-center p-6 transition-all duration-500 opacity-0 pointer-events-none z-20">
        <div>
          <div class="text-4xl mb-3">🌿</div>
          <p class="font-display text-xl text-goldBright font-semibold">{eco.lntThankYou}</p>
          <button id="lnt-reset" class="mt-4 text-xs text-ivory/60 hover:text-ivory underline underline-offset-4">Reset</button>
        </div>
      </div>
    </div>

    <!-- Fauna & Flora checklist -->
    {eco.checklist && (
      <div class="mt-12">
        <h3 class="font-display text-2xl text-teak mb-1">{eco.checklist.title}</h3>
        <p class="text-sm text-ink/75 mb-5">{eco.checklist.intro}</p>
        <div class="grid sm:grid-cols-2 gap-4">
          {eco.checklist.items.map((c) => (
            <div class={`rounded-2xl border p-5 ${c.rareClass === 'warn' ? 'border-red-300 bg-red-50' : 'border-gold/25 bg-white/50'}`}>
              <div class="flex items-center gap-3">
                <span class="text-2xl" aria-hidden="true">{c.emoji}</span>
                <span class="font-display text-teak font-semibold text-lg">{c.name}</span>
              </div>
              <p class="mt-2 text-sm text-ink/75"><span class="font-medium text-gold">🗓 {c.best}</span></p>
              <p class="mt-1 text-sm text-ink/70"><span class="font-medium {c.rareClass === 'warn' ? 'text-red-700' : 'text-teak'}">{c.rare}</span></p>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const checkboxes = document.querySelectorAll('.lnt-checkbox');
    const thankYou = document.getElementById('lnt-thankyou');
    const resetBtn = document.getElementById('lnt-reset');
    
    // Accordion Logic
    const accordionBtns = document.querySelectorAll('.accordion-btn');
    accordionBtns.forEach(btn => {
      btn.addEventListener('click', function() {
        const content = this.nextElementSibling;
        const icon = this.querySelector('.accordion-icon');
        
        // Close all other accordions
        accordionBtns.forEach(otherBtn => {
          if (otherBtn !== this) {
            otherBtn.classList.remove('bg-gold/5');
            const otherContent = otherBtn.nextElementSibling;
            const otherIcon = otherBtn.querySelector('.accordion-icon');
            otherContent.style.maxHeight = null;
            otherIcon.classList.remove('rotate-180');
          }
        });

        // Toggle current accordion
        this.classList.toggle('bg-gold/5');
        icon.classList.toggle('rotate-180');
        
        if (content.style.maxHeight) {
          content.style.maxHeight = null;
        } else {
          content.style.maxHeight = content.scrollHeight + "px";
        }
      });
    });

    if (!checkboxes.length || !thankYou) return;

    const LNT_KEY = 'visitmaekampong_lnt_agreed';
    
    function checkAll() {
      const allChecked = Array.from(checkboxes).every(cb => cb.checked);
      if (allChecked) {
        thankYou.classList.remove('opacity-0', 'pointer-events-none');
        thankYou.classList.add('opacity-100', 'pointer-events-auto');
        localStorage.setItem(LNT_KEY, 'true');
      } else {
        thankYou.classList.add('opacity-0', 'pointer-events-none');
        thankYou.classList.remove('opacity-100', 'pointer-events-auto');
        localStorage.removeItem(LNT_KEY);
      }
    }

    // Load from local storage
    if (localStorage.getItem(LNT_KEY) === 'true') {
      checkboxes.forEach(cb => cb.checked = true);
      checkAll();
    }

    checkboxes.forEach(cb => {
      cb.addEventListener('change', checkAll);
    });

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        checkboxes.forEach(cb => cb.checked = false);
        checkAll();
      });
    }
  });
</script>
