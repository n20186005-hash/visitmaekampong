---
import { siteConfig } from '../config';

interface Props {
  messages: Record<string, any>;
}
const { messages } = Astro.props;
const lm = messages.landmarks;
const entity = messages.entity || {};
const mapsUrl = siteConfig.mapsUrl;
const portalUrl = siteConfig.entity.govtTourismUrl;
const landmarkImgs = [5, 4, 16, 2].map(
  (n) => `/gallery/${siteConfig.galleryPrefix}${n}.${siteConfig.galleryExt}`
);
---

{
  lm && (
    <section id="landmarks" class="py-20 bg-teakDeep text-ivory">
      <div class="max-w-7xl mx-auto px-5">
        <p class="font-hand text-gold text-xl md:text-2xl">{lm.label}</p>
        <h2 class="font-display font-semibold text-3xl md:text-5xl text-ivory mt-2">{lm.heading}</h2>
        <p class="mt-4 max-w-3xl text-ivory/80">{lm.lead}</p>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 mt-10">
          {lm.items.map((it, i) => (
            <a
              href={it.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group rounded-2xl overflow-hidden border border-gold/20 bg-teak/50 hover:border-gold transition-colors"
            >
              <img
                src={landmarkImgs[i % landmarkImgs.length]}
                alt={`${it.name} near ${siteConfig.entity.shortName}`}
                loading="lazy"
                class="w-full h-36 object-cover"
              />
              <div class="p-4">
                <div class="font-display text-lg text-goldBright">{it.name}</div>
                <p class="mt-2 text-sm text-ivory/75 leading-relaxed">{it.desc}</p>
                <span class="mt-3 inline-block text-xs text-ivory/60 group-hover:text-goldBright">
                  {lm.viewOnMaps} →
                </span>
              </div>
            </a>
          ))}
        </div>

        <!-- 权威出站链接：当地政府 / 官方旅游局 -->
        {portalUrl && (
          <p class="mt-8 text-sm text-ivory/70">
            {entity.portalIntro}{' '}
            <a
              href={portalUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-goldBright hover:underline"
            >
              {entity.portalLabel}
            </a>
            .
          </p>
        )}

        <p class="mt-4 text-sm text-ivory/70">
          <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="text-goldBright hover:underline">
            {siteConfig.entity.fullName} · {lm.viewOnMaps} ↗
          </a>
        </p>
      </div>
    </section>
  )
}
