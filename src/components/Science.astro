---
interface Props {
  messages: Record<string, any>;
}
const { messages } = Astro.props;
const sc = messages.science;
---

{
  sc && (
    <section id="science" class="py-20 bg-ivory text-ink">
      <div class="max-w-7xl mx-auto px-5">
        <p class="font-hand text-gold text-xl md:text-2xl">{sc.label}</p>
        <h2 class="font-display font-semibold text-3xl md:text-5xl text-teak mt-2">{sc.heading}</h2>
        <p class="mt-4 max-w-3xl text-ink/75">{sc.lead}</p>

        <div class="mt-10 grid md:grid-cols-2 gap-4">
          {sc.cards.map((c: any) => (
            <article class="rounded-2xl border border-teak/15 bg-white/70 p-6">
              <div class="text-3xl" aria-hidden="true">{c.icon}</div>
              <h3 class="mt-3 font-display text-xl text-teak">{c.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink/80">{c.text}</p>
            </article>
          ))}
        </div>

        <div class="mt-12 grid md:grid-cols-2 gap-8">
          <div>
            <h3 class="font-display text-2xl text-teak">{sc.responsibilityTitle}</h3>
            <ul class="mt-4 space-y-2 text-sm text-ink/80">
              {sc.responsibility.map((r: string) => (
                <li class="flex gap-2">
                  <span class="text-gold" aria-hidden="true">•</span>
                  <span>{r}</span>
                </li>
              ))}
            </ul>
          </div>
          <div>
            <h3 class="font-display text-2xl text-teak">{sc.etiquetteTitle}</h3>
            <ul class="mt-4 space-y-2 text-sm text-ink/80">
              {sc.etiquette.map((e: string) => (
                <li class="flex gap-2">
                  <span class="text-gold" aria-hidden="true">•</span>
                  <span>{e}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>
  )
}
