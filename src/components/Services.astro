---
interface Props {
  messages: Record<string, any>;
}
const { messages } = Astro.props;
const sv = messages.services;
---

{
  sv && (
    <section id="services" class="py-20 bg-ivory text-ink">
      <div class="max-w-7xl mx-auto px-5">
        <p class="font-hand text-gold text-xl md:text-2xl">{sv.label}</p>
        <h2 class="font-display font-semibold text-3xl md:text-5xl text-teak mt-2">{sv.heading}</h2>
        <p class="mt-4 max-w-3xl text-ink/75">{sv.lead}</p>

        <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {sv.items.map((it: any) => (
            <article class="rounded-2xl border border-teak/15 bg-white/70 p-5">
              <div class="text-3xl" aria-hidden="true">{it.icon}</div>
              <h3 class="mt-3 font-display text-xl text-teak">{it.name}</h3>
              <p class="mt-1 inline-block rounded-full bg-teak/10 px-3 py-1 text-[11px] text-teak/80">
                {sv.typeLabel}: {it.type}
              </p>
              <p class="mt-3 text-sm leading-relaxed text-ink/75">{it.desc}</p>
              <p class="mt-3 border-t border-teak/10 pt-3 text-xs text-ink/60">{it.tip}</p>
            </article>
          ))}
        </div>

        <p class="mt-8 rounded-xl border-l-4 border-gold bg-white/50 px-4 py-3 text-sm text-ink/70">
          {sv.note}
        </p>
      </div>
    </section>
  )
}
