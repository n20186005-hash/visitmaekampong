---
import { siteConfig } from '../config';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  messages: Record<string, any>;
}
const { lang, messages } = Astro.props;
const hero = messages.hero;

const main = hero.titleMain as string;
const accent = hero.titleAccent as string;
const parts = main.split(accent);
const heroImg = `/gallery/${siteConfig.galleryPrefix}15.${siteConfig.galleryExt}`;
const mapsUrl = siteConfig.mapsUrl;
const coordsLabel = hero.coordsLabel;

// Full weather-code labels (all languages); only the current language is shipped per page.
const WEATHER_CODES: Record<number, Record<string, { t: string; s: string }>> = {
  0: { th: { t: 'ท้องฟ้าโปร่งใส', s: 'แดดจัด' }, en: { t: 'Clear sky', s: 'Sunny' }, zh: { t: '晴空', s: '晴' } },
  1: { th: { t: 'โปร่งโล่ง', s: 'ส่วนใหญ่โปร่ง' }, en: { t: 'Mainly clear', s: 'Mostly clear' }, zh: { t: '少云', s: '少云' } },
  2: { th: { t: 'มีเมฆบางส่วน', s: 'มีเมฆบางส่วน' }, en: { t: 'Partly cloudy', s: 'Partly cloudy' }, zh: { t: '局部多云', s: '局部多云' } },
  3: { th: { t: 'เมฆมาก', s: 'เมฆมาก' }, en: { t: 'Overcast', s: 'Overcast' }, zh: { t: '阴', s: '阴' } },
  45: { th: { t: 'หมอก', s: 'หมอก' }, en: { t: 'Fog', s: 'Fog' }, zh: { t: '雾', s: '雾' } },
  48: { th: { t: 'หมอกแข็ง', s: 'หมอก' }, en: { t: 'Rime fog', s: 'Fog' }, zh: { t: '雾凇', s: '雾' } },
  51: { th: { t: 'ฝนปรอยเล็กน้อย', s: 'ฝนปรอย' }, en: { t: 'Light drizzle', s: 'Drizzle' }, zh: { t: '小毛毛雨', s: '毛毛雨' } },
  53: { th: { t: 'ฝนปรอยปานกลาง', s: 'ฝนปรอย' }, en: { t: 'Drizzle', s: 'Drizzle' }, zh: { t: '毛毛雨', s: '毛毛雨' } },
  55: { th: { t: 'ฝนปรอยหนัก', s: 'ฝนปรอย' }, en: { t: 'Dense drizzle', s: 'Drizzle' }, zh: { t: '浓毛毛雨', s: '毛毛雨' } },
  61: { th: { t: 'ฝนตกเล็กน้อย', s: 'ฝนตก' }, en: { t: 'Light rain', s: 'Rain' }, zh: { t: '小雨', s: '雨' } },
  63: { th: { t: 'ฝนตกปานกลาง', s: 'ฝนตก' }, en: { t: 'Rain', s: 'Rain' }, zh: { t: '中雨', s: '雨' } },
  65: { th: { t: 'ฝนตกหนัก', s: 'ฝนตก' }, en: { t: 'Heavy rain', s: 'Rain' }, zh: { t: '大雨', s: '雨' } },
  71: { th: { t: 'หิมะตกเล็กน้อย', s: 'หิมะ' }, en: { t: 'Light snow', s: 'Snow' }, zh: { t: '小雪', s: '雪' } },
  73: { th: { t: 'หิมะตกปานกลาง', s: 'หิมะ' }, en: { t: 'Snow', s: 'Snow' }, zh: { t: '中雪', s: '雪' } },
  75: { th: { t: 'หิมะตกหนัก', s: 'หิมะ' }, en: { t: 'Heavy snow', s: 'Snow' }, zh: { t: '大雪', s: '雪' } },
  80: { th: { t: 'ฝนตกเป็นระยะ', s: 'ฝนตก' }, en: { t: 'Rain showers', s: 'Showers' }, zh: { t: '阵雨', s: '阵雨' } },
  81: { th: { t: 'ฝนตกเป็นระยะปานกลาง', s: 'ฝนตก' }, en: { t: 'Rain showers', s: 'Showers' }, zh: { t: '阵雨', s: '阵雨' } },
  82: { th: { t: 'ฝนตกเป็นระยะหนัก', s: 'ฝนตก' }, en: { t: 'Violent showers', s: 'Showers' }, zh: { t: '强阵雨', s: '阵雨' } },
  95: { th: { t: 'พายุฝนฟ้าคะนอง', s: 'ฟ้าคะนอง' }, en: { t: 'Thunderstorm', s: 'Storm' }, zh: { t: '雷阵雨', s: '雷雨' } },
  96: { th: { t: 'พายุฝนฟ้าคะนองลูกเห็บ', s: 'ฟ้าคะนอง' }, en: { t: 'Thunderstorm', s: 'Storm' }, zh: { t: '雷阵雨', s: '雷雨' } },
  99: { th: { t: 'พายุฝนฟ้าคะนองลูกเห็บหนัก', s: 'ฟ้าคะนอง' }, en: { t: 'Severe thunderstorm', s: 'Storm' }, zh: { t: '强雷阵雨', s: '雷雨' } },
};
const weatherMap = Object.fromEntries(
  Object.entries(WEATHER_CODES).map(([k, v]) => [k, v[lang] ?? v.en])
);
---

<section id="home" class="relative min-h-[90vh] md:min-h-screen flex items-center justify-center overflow-hidden">
  <img src={heroImg} alt={main} class="absolute inset-0 w-full h-full object-cover object-center" />
  <div class="absolute inset-0 bg-gradient-to-t from-teakDeep via-teakDeep/60 to-black/30"></div>
  <div class="hero-glow absolute inset-0"></div>

  <div class="relative z-10 max-w-5xl mx-auto w-full px-5 text-center text-ivory flex flex-col items-center">
    <p class="font-hand text-gold text-xl md:text-2xl mb-4">{hero.eyebrow}</p>
    <h1 class="font-display font-semibold leading-[1.05] text-5xl md:text-7xl lg:text-8xl mb-6">
      {parts[0]}<span class="gold-text-bright">{accent}</span>{parts[1] ?? ''}
    </h1>
    <h2 class="text-2xl md:text-3xl font-semibold mb-6 text-ivory/90 tracking-wide">{hero.slogan}</h2>
    <p class="max-w-2xl text-ivory/80 text-lg md:text-xl leading-relaxed">{hero.subtitle}</p>

    <div class="mt-10 flex flex-wrap justify-center items-center gap-4">
      <a href="#about" class="inline-flex items-center gap-2 bg-gold text-teak font-semibold px-8 py-4 rounded-full hover:bg-goldBright transition-colors text-base md:text-lg">
        {hero.cta1}
      </a>
      <a href="#guide" class="inline-flex items-center gap-2 border border-gold/50 text-ivory px-8 py-4 rounded-full hover:border-goldBright hover:text-goldBright transition-colors text-base md:text-lg backdrop-blur-sm bg-black/20">
        {hero.cta2}
      </a>
    </div>

    <div class="mt-12 flex flex-wrap justify-center items-center gap-4 text-sm text-ivory/80">
      <span class="stars text-lg">★ {hero.rating}</span>
      <span>{hero.reviewCount} Google</span>
      <span class="hidden sm:inline text-ivory/40">·</span>
      <a href={mapsUrl} target="_blank" rel="noopener" class="hover:text-goldBright underline-offset-4 hover:underline transition-colors flex items-center gap-1">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
        </svg>
        {hero.coordsLabel}
      </a>
    </div>
  </div>

  <!-- Floating Weather Widget (Bottom Right) -->
  <div class="absolute bottom-6 right-6 lg:bottom-10 lg:right-10 z-20 hidden md:block w-72">
    <div class="weather-widget backdrop-blur-md bg-teakDeep/80 border border-gold/20 rounded-2xl p-4 shadow-2xl transition-transform hover:-translate-y-1">
      <div class="flex items-center justify-between mb-3 border-b border-gold/10 pb-2">
        <span class="text-[11px] uppercase tracking-wider text-goldBright font-semibold">{hero.plannerTitle}</span>
        <div class="flex items-center gap-1.5" title={hero.plannerNote}>
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
          </span>
          <span id="weather-status" class="text-[10px] text-ivory/60">{hero.liveWeather}</span>
        </div>
      </div>
      
      <div id="weather-body" class="transition-opacity duration-500">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <span id="cur-icon" class="text-3xl drop-shadow-md">🌦️</span>
            <div>
              <div class="flex items-baseline gap-1">
                <span id="cur-temp" class="font-display text-3xl font-bold text-ivory">{hero.defaultTemp}</span>
              </div>
              <div id="cur-cond" class="text-[13px] text-ivory/80 leading-none">{hero.defaultCond}</div>
            </div>
          </div>
          <div class="text-right flex flex-col justify-center">
            <div class="text-[11px] text-ivory/60 mb-0.5">{hero.sunsetLabel} <span id="sunset-time" class="text-ivory font-semibold">{hero.defaultSunset}</span></div>
            <div class="text-[11px] text-ivory/60">
              <svg xmlns="http://www.w3.org/2000/svg" class="inline h-3 w-3 text-goldBright" viewBox="0 0 20 20" fill="currentColor">
                <path d="M11 3a1 1 0 10-2 0v1a1 1 0 102 0V3zM15.657 5.757a1 1 0 00-1.414-1.414l-.707.707a1 1 0 001.414 1.414l.707-.707zM18 10a1 1 0 01-1 1h-1a1 1 0 110-2h1a1 1 0 011 1zM5.05 6.464A1 1 0 106.464 5.05l-.707-.707a1 1 0 00-1.414 1.414l.707.707zM5 10a1 1 0 01-1 1H3a1 1 0 110-2h1a1 1 0 011 1zM8 16v-1h4v1a2 2 0 11-4 0zM12 14c.015-.34.208-.646.477-.859a4 4 0 10-4.954 0c.27.213.462.519.476.859h4z" />
              </svg>
              <span id="golden-time" class="text-goldBright font-semibold">{hero.defaultGolden.split(' ')[0]}</span>
            </div>
          </div>
        </div>
        
        <div class="mt-3 pt-3 border-t border-gold/10">
          <div class="flex justify-between items-center text-[11px]">
            <span class="text-ivory/70">{hero.sunsetIndexLabel}</span>
            <span id="sunset-index" class="font-semibold text-goldBright">{hero.sunsetIndexDefault}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ lang, lat: siteConfig.coords.lat, lon: siteConfig.coords.lng, weatherError: hero.weatherError, weatherMap, goldenChanceLabel: hero.goldenChanceLabel }}>
  (function () {
    // Mae Kampong Village — live weather/sunset coordinates from siteConfig.coords
    const LAT = lat, LON = lon;

    function weatherText(code, mode) {
      const e = weatherMap[code] || weatherMap[3];
      return mode === 'short' ? e.s : e.t;
    }

    // Golden-light probability from the current weather code
    function goldenChance(code) {
      if (code === 0) return 95;
      if (code <= 2) return 85;
      if (code === 3) return 60;
      if (code === 45 || code === 48) return 50;
      if (code >= 51 && code <= 67) return 30;
      if (code >= 71 && code <= 82) return 35;
      if (code >= 95) return 15;
      return 70;
    }

    function iconFor(code) {
      if (code === 0) return '☀️';
      if (code <= 2) return '🌤️';
      if (code === 3) return '☁️';
      if (code === 45 || code === 48) return '🌫️';
      if (code >= 51 && code <= 57) return '🌦️';
      if (code >= 61 && code <= 67) return '🌧️';
      if (code >= 71 && code <= 77) return '❄️';
      if (code >= 80 && code <= 82) return '🌦️';
      if (code >= 95) return '⛈️';
      return '🌡️';
    }

    const pad = (n) => String(n).padStart(2, '0');
    const fmtDate = (d) => pad(d.getHours()) + ':' + pad(d.getMinutes());

    const statusEl = document.getElementById('weather-status');
    const bodyEl = document.getElementById('weather-body');

    fetch(`https://api.open-meteo.com/v1/forecast?latitude=${LAT}&longitude=${LON}&current=temperature_2m,weather_code,wind_speed_10m&daily=weather_code,sunrise,sunset&timezone=Asia/Bangkok&wind_speed_unit=kmh`)
      .then((r) => r.json())
      .then((d) => {
        if (!d || !d.current || !d.daily) throw new Error('bad');
        document.getElementById('cur-temp').textContent = Math.round(d.current.temperature_2m) + '°';
        document.getElementById('cur-cond').textContent = weatherText(d.current.weather_code, 'title');
        document.getElementById('cur-wind').textContent = Math.round(d.current.wind_speed_10m) + ' km/h';
        document.getElementById('cur-icon').textContent = iconFor(d.current.weather_code);

        // Today's sunset-observation index (condition + golden-light chance)
        const idxEl = document.getElementById('sunset-index');
        if (idxEl) {
          idxEl.textContent = iconFor(d.current.weather_code) + ' ' + weatherText(d.current.weather_code, 'short') + ' · ' + goldenChanceLabel + ' ' + goldenChance(d.current.weather_code) + '%';
        }

        // Live sunrise / sunset / blue hour (based on the attraction's actual coordinates)
        const fmt = (date) => pad(date.getHours()) + ':' + pad(date.getMinutes());
        const addMin = (date, m) => new Date(date.getTime() + m * 60000);
        const sr = new Date(d.daily.sunrise[0]);
        const ss = new Date(d.daily.sunset[0]);
        const gEl = document.getElementById('golden-time');
        const sEl = document.getElementById('sunset-time');
        const bEl = document.getElementById('blue-time');
        if (gEl) gEl.textContent = fmt(sr) + ' – ' + fmt(addMin(sr, 90));
        if (sEl) sEl.textContent = fmt(ss);
        if (bEl) bEl.textContent = fmt(addMin(ss, 20)) + ' – ' + fmt(addMin(ss, 50));

        if (statusEl) statusEl.textContent = weatherError ? '' : '';
        if (bodyEl) bodyEl.classList.remove('hidden');
      })
      .catch(() => {
        // keep static default values; do not break the card layout
        if (bodyEl) bodyEl.classList.remove('hidden');
      });
  })();
</script>
